{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workshop-md-converter",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-21",
  "cache": {
    "enabled": true
  },
  "vars": {
    "UPSTREAM_BASE_URL": "https://workshop.codes",
    "UPSTREAM_ARTICLES_PATH": "/wiki/articles.json",
    "PUBLIC_BASE_URL": "https://md.wrightkit.dev",
    "RENDERER_VERSION": "v1",
    "CACHE_TTL_SECONDS": "300",
    "UPSTREAM_CACHE_TTL_SECONDS": "60"
  },
  "observability": {
    "enabled": true
  }
}
